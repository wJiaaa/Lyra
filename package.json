{
  "name": "plume",
  "version": "0.9.21",
  "private": true,
  "type": "module",
  "description": "Plume — a fully self-hosted code agent with custom models, tools, skills and MCP. Desktop app built on Electron.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @plume/desktop dev",
    "cli": "node packages/cli/src/main.ts",
    "build": "pnpm --filter @plume/core build && pnpm --filter @plume/desktop build",
    "build:core": "pnpm --filter @plume/core build",
    "package": "pnpm build && pnpm --filter @plume/desktop package",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --deny-warnings",
    "i18n": "node scripts/check-i18n.mjs",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "test": "pnpm -r --no-bail test && node --test --experimental-strip-types test/*.test.ts",
    "test:unit": "pnpm -r --no-bail test",
    "check": "pnpm lint && pnpm check:links && pnpm style && pnpm i18n && pnpm typecheck && pnpm arch && pnpm test",
    "prepare": "lefthook install",
    "test:e2e": "pnpm --filter @plume/desktop test:e2e",
    "audit:sessions": "node --experimental-strip-types scripts/session-audit.ts",
    "audit:prune": "node --experimental-strip-types scripts/session-prune-audit.ts",
    "probe:parallel": "node --experimental-strip-types scripts/probe-parallel-calls.ts",
    "probe:prune": "node --experimental-strip-types scripts/probe-prune-accuracy.ts",
    "catalog:update": "node --experimental-strip-types scripts/update-model-catalog.ts",
    "release": "node scripts/release.mjs",
    "arch": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json packages/cli/src packages/contract/src packages/core/src packages/desktop/src packages/desktop/shared packages/desktop/electron packages/registry-shared/src",
    "arch:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline packages/cli/src packages/contract/src packages/core/src packages/desktop/src packages/desktop/shared packages/desktop/electron packages/registry-shared/src > .dependency-cruiser-known-violations.json",
    "check:links": "node scripts/check-links.mjs",
    "style": "stylelint packages/desktop/src/**/*.css"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "24.13.3",
    "dependency-cruiser": "^18.2.0",
    "git-cliff": "^2.13.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "oxlint": "^1.80.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wJiaaa/Plume.git"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "koffi"
    ]
  }
}
