{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Every package needs an entry: a workspace knip does not know about is a workspace whose
  // dead code it cannot see, which is the opposite of what this file is for.
  //
  // Tests are entry points. They are a legitimate consumer: a helper exported so a test can drive
  // it directly is not dead, and this repo requires the test. The patterns are `test/**` rather
  // than `test/*` because the component tests live in `test/ui/`, and `e2e/**` is listed because
  // the real-window probes import a great deal that nothing else does.
  "workspaces": {
    "packages/core": {
      "entry": ["src/index.ts", "src/**/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contract": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/desktop": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "electron/sandbox-runner.ts",
        "src/main.tsx",
        "test/**/*.test.{ts,tsx}",
        "e2e/**/*.ts",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "electron/**/*.ts", "shared/**/*.ts"]
    },
    "packages/registry-shared": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    ".": {
      // Each of these is a command someone runs by hand or a hook runs for them. Nothing imports
      // them, which is the point, and without this they read as unused files.
      "entry": ["scripts/**/*.mjs", "test/**/*.test.ts"]
    }
  },

  "ignoreDependencies": [
    "lefthook",

    // The desktop's own copy of the sandbox runners' FFI. Core loads it with
    // `createRequire(import.meta.url)`, which resolves from wherever the code ended up — the
    // desktop's `out/main` once bundled — and knip cannot follow a require it cannot see. Without
    // the dependency the bundle cannot find it, and the Windows and Landlock runners cannot start.
    "koffi",

    // Fonts, reached from `src/styles/fonts.css` as `url("@fontsource-variable/…/files/…woff2")`.
    // knip does not follow CSS — it says so itself, as a configuration hint — so every font this
    // app ships looks unused to it. Removing them would drop the monospace faces the code panes
    // and the appearance page offer.
    "@fontsource-variable/inter",
    "@fontsource-variable/ibm-plex-sans",
    "@fontsource-variable/jetbrains-mono",
    "@fontsource-variable/fira-code",
    "@fontsource-variable/source-code-pro",
    "@fontsource/ibm-plex-mono",

    // Run as a binary, never imported: `npx git-cliff` in `scripts/release.mjs` builds the
    // changelog section. The dependency is what makes that resolve locally rather than fetching a
    // different version mid-release.
    "git-cliff",

    "tailwindcss",
    "@electron/rebuild",
    "@modelcontextprotocol/sdk",
    // Built-in formatter engines and plugins dynamically imported in `format-builtin-engines.ts`
    "@prettier/plugin-php",
    "@scalar/swift-fmt",
    "@wasm-fmt/clang-format",
    "@wasm-fmt/dart_fmt",
    "@wasm-fmt/gofmt",
    "@wasm-fmt/ruff_fmt",
    "prettier-plugin-latex",
    "prettier-plugin-sh",
    "prettier-plugin-toml"
  ],

  "ignore": ["**/node_modules/**", "**/dist/**", "**/out/**"],

  // External tools this code shells out to, which are meant to be absent on a machine that does
  // not need them: `rg` for grep, `bwrap` for the Linux sandbox, `ffmpeg` to encode the recording
  // an e2e probe makes, `objdump` for the glibc check that runs after a Linux package is built.
  "ignoreBinaries": ["rg", "bwrap", "ffmpeg", "objdump"]
}
