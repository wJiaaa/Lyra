{
	"name": "@plume/desktop",
	"desktopName": "Plume.desktop",
	"version": "0.9.29",
	"homepage": "https://github.com/wJiaaa/Lyra",
	"author": {
		"name": "kittors",
		"email": "kittors@users.noreply.github.com"
	},
	"private": true,
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "node scripts/brand-dev-electron.mjs && electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm test:unit && pnpm test:ui",
		"test:unit": "node --test --import ./test/setup.ts --experimental-strip-types test/*.test.ts",
		"test:ui": "node --import tsx --import ./test/helpers/dom.ts --import ./test/helpers/assets.mjs --test test/ui/*.test.ts",
		"postinstall": "node scripts/rebuild-pty.mjs && node scripts/brand-dev-electron.mjs",
		"rebuild:pty": "node scripts/rebuild-pty.mjs",
		"package": "node scripts/brand-dev-electron.mjs --restore && electron-vite build && node scripts/package.mjs",
		"test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 --experimental-strip-types e2e/*.test.ts",
		"brand:dev": "node scripts/brand-dev-electron.mjs",
		"brand:restore": "node scripts/brand-dev-electron.mjs --restore",
		"tray:icons": "node scripts/make-tray-icons.mjs",
		"dock:icons": "node scripts/make-dock-icons.mjs",
		"gallery": "node scripts/gallery.mjs"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-go": "^6.0.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-less": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-php": "^6.0.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/lang-sass": "^6.0.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-vue": "^0.1.3",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@lezer/common": "^1.5.3",
		"@lezer/highlight": "^1.2.5",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@plume/client-runtime": "workspace:*",
		"@plume/contract": "workspace:*",
		"@plume/core": "workspace:*",
		"@plume/registry-shared": "workspace:*",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-search": "0.16.0",
		"@xterm/addon-unicode11": "0.9.0",
		"@xterm/addon-web-links": "0.12.0",
		"@xterm/xterm": "6.0.0",
		"docx-preview": "^0.4.1",
		"fflate": "^0.8.3",
		"katex": "0.19.0",
		"koffi": "^3.3.3",
		"mermaid": "^12.1.0",
		"motion": "14.1.0",
		"node-pty": "1.1.0",
		"qrcode": "^1.5.4",
		"thinking-orbs": "^0.3.2",
		"undici": "7.30.0",
