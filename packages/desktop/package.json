		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.1.2",
		"electron": "44.7.0",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"happy-dom": "^20.14.6",
		"lucide-react": "1.55.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tailwindcss": "4.3.3",
		"tsx": "^4.23.15",
