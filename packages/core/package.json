{
	"name": "@plume/core",
	"version": "0.9.23",
	"private": true,
	"type": "module",
	"description": "Plume agent kernel: providers, agent loop, tools, skills, MCP, sessions",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./thinking-options": "./src/ai/thinking-options.ts",
		"./tokens": "./src/tokens.ts",
		"./activity": "./src/activity.ts",
		"./trajectory-view": "./src/trajectory-view.ts",
		"./commands-view": "./src/commands-view.ts",
		"./schedule": "./src/config/schedule.ts",
		"./model-roles": "./src/config/model-roles.ts",
		"./project-folders": "./src/config/project-folders.ts",
		"./retry-policy": "./src/config/retry-policy.ts",
		"./agents-builtin": "./src/agents-builtin.ts",
		"./model-catalog": "./src/model-catalog.ts",
		"./model-catalog-sync": "./src/model-catalog-sync.ts",
		"./commands-builtin": "./src/commands/builtin.ts",
		"./install-record": "./src/plugins/install-record.ts",
		"./mcp-placeholders": "./src/mcp/placeholders.ts",
		"./sandbox-runner": "./src/sandbox/runner-entry.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --test --import ./test/setup.ts --experimental-strip-types test/*.test.ts"
	},
	"dependencies": {
		"@plume/registry-shared": "workspace:*",
		"@modelcontextprotocol/sdk": "1.30.0",
		"fflate": "^0.8.3",
		"unpdf": "^1.8.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"yaml": "2.9.0",
		"koffi": "^3.1.6"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"typescript": "5.9.3"
	}
}
