{
	"name": "@lyra/cli",
	"version": "0.9.21",
	"private": true,
	"type": "module",
	"description": "Lyra without a window: runs one task non-interactively with the desktop app's settings, for evaluation.",
	"bin": {
		"lyra": "./src/main.ts"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
