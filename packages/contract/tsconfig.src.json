{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /*
     * No `lib` beyond the language, and no `types` at all.
     *
     * This is what keeps the package portable. It depends on nothing, so anything may import it;
     * a `node:` type creeping in here would compile fine and quietly change that.
     */
    "lib": ["ES2023"],
    "types": [],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true
  },
  "include": ["src/**/*.ts"]
}
